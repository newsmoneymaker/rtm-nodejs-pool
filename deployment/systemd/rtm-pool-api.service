[Unit]
Description=Raptoreum pool: public API (127.0.0.1:8124)
After=rtm-pool-redis.service rtm-node.service
Requires=rtm-pool-redis.service
[Service]
Type=simple
User=rtmpool
WorkingDirectory=/opt/rtm-nodejs-pool
ExecStart=/usr/bin/node /opt/rtm-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
