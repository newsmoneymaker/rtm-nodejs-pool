[Unit]
Description=Redis for the Raptoreum pool (127.0.0.1:6386, AOF)
After=network.target

[Service]
Type=simple
User=rtmpool
ExecStart=/usr/bin/redis-server /opt/rtm-nodejs-pool/deployment/redis-pool.conf.example
Restart=always
RestartSec=3
LimitNOFILE=10032
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
